<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="supertext_translation_link" resource="default" engine="innodb" comment="Supertext: CMS page and block translations (source → copy per store view)">
        <column xsi:type="int" name="link_id" unsigned="true" nullable="false" identity="true" comment="Link ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="cms_page or cms_block"/>
        <column xsi:type="int" name="source_id" unsigned="true" nullable="false" comment="Original page or block"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Target store view"/>
        <column xsi:type="int" name="target_id" unsigned="true" nullable="false" comment="Translated copy"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Last translated"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="link_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SUPERTEXT_TRANSLATION_LINK_TYPE_SOURCE_STORE">
            <column name="entity_type"/>
            <column name="source_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="SUPERTEXT_TRANSLATION_LINK_TYPE_TARGET" indexType="btree">
            <column name="entity_type"/>
            <column name="target_id"/>
        </index>
    </table>
</schema>
