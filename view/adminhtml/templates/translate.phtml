<?php
$texts = [
    'running' => (string) __('Translating…'),
    'queued'  => (string) __('Waiting…'),
    'failed'  => (string) __('Failed'),
    'noStore' => (string) __('Choose at least one store view to translate into.'),
    'done'    => (string) __('Done: %1 translated, %2 unchanged, %3 failed.'),
    'hint'    => (string) __('To replace existing translations, tick "Overwrite existing translations" and translate again.'),
    'open'    => (string) __('Open'),
    'importing' => (string) __('Importing…'),
    'noFile'  => (string) __('Choose a file to import.'),
    'tooLarge' => (string) __('The file is too large (at most 10 MB).'),
];
$script = 'window.supertextTexts = ' . json_encode($texts, JSON_HEX_TAG | JSON_HEX_AMP | JSON_UNESCAPED_UNICODE) . ';' . <<<'JS'
require(['jquery'], function ($) {
    var root = document.querySelector('[data-role="supertext-translate"]');
    var t = window.supertextTexts;
    var exportForm = root && root.querySelector('.supertext-export-form');
    if (exportForm) {
        // The store views and "overwrite" ticked above go into the export.
        exportForm.addEventListener('submit', function (event) {
            exportForm.querySelectorAll('input[data-copied]').forEach(function (input) { input.remove(); });
            var stores = root.querySelectorAll('.supertext-target:checked');
            if (!stores.length) { event.preventDefault(); alert(t.noStore); return; }
            stores.forEach(function (c) { add('stores[]', c.value); });
            if (root.querySelector('#supertext-overwrite').checked) { add('overwrite', '1'); }
            function add(name, value) {
                var input = document.createElement('input');
                input.type = 'hidden'; input.name = name; input.value = value; input.setAttribute('data-copied', '1');
                exportForm.appendChild(input);
            }
        });
    }
    var importForm = root && root.querySelector('.supertext-import-form');
    if (importForm) {
        importForm.addEventListener('submit', async function (event) {
            event.preventDefault();
            var file = importForm.querySelector('#supertext-file').files[0];
            var out = root.querySelector('.supertext-import-result');
            out.textContent = '';
            if (!file) { alert(t.noFile); return; }
            if (file.size > 10000000) { show('message-error', t.tooLarge); return; }
            var button = importForm.querySelector('.supertext-import');
            var data = new FormData(importForm);
            data.append('form_key', window.FORM_KEY);
            button.disabled = true;
            show('', t.importing);
            try {
                var response = await fetch(root.getAttribute('data-import-url'), { method: 'POST', body: data, credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                var result = await response.json();
                out.textContent = '';
                if (!result.ok) {
                    show('message-error', result.message || t.failed);
                } else {
                    result.jobs.forEach(function (job) {
                        var box = show(job.ok ? 'message-success' : 'message-error', job.title);
                        if (job.editUrl) {
                            var link = document.createElement('a'); link.href = job.editUrl; link.textContent = ' ' + t.open;
                            box.firstElementChild.appendChild(link);
                        }
                        var list = document.createElement('ul');
                        (job.error ? [job.error] : job.lines.concat(job.notes)).forEach(function (line) {
                            var li = document.createElement('li'); li.textContent = line; list.appendChild(li);
                        });
                        box.firstElementChild.appendChild(list);
                    });
                }
            } catch (e) {
                out.textContent = '';
                show('message-error', t.failed);
            }
            button.disabled = false;
            function show(kind, text) {
                var box = document.createElement('div'); box.className = 'message ' + kind;
                var inner = document.createElement('div'); inner.textContent = text; box.appendChild(inner);
                out.appendChild(box);
                return box;
            }
        });
    }
    var go = root && root.querySelector('.supertext-go');
    if (!go) { return; }
    go.addEventListener('click', async function () {
        var stores = Array.prototype.map.call(root.querySelectorAll('.supertext-target:checked'), function (c) { return c.value; });
        if (!stores.length) { alert(t.noStore); return; }
        var overwrite = root.querySelector('#supertext-overwrite').checked;
        var jobs = [];
        root.querySelectorAll('.supertext-table tbody tr').forEach(function (row) {
            stores.forEach(function (store) {
                var cell = row.querySelector('td[data-store="' + store + '"] .supertext-state');
                cell.className = 'supertext-state queued'; cell.textContent = t.queued;
                jobs.push({ id: row.getAttribute('data-id'), store: store, cell: cell });
            });
        });
        go.disabled = true;
        var counts = { ok: 0, skipped: 0, failed: 0 };
        for (var i = 0; i < jobs.length; i++) {
            var job = jobs[i];
            job.cell.className = 'supertext-state running'; job.cell.textContent = t.running;
            try {
                var data = await $.ajax({
                    url: root.getAttribute('data-run-url'), method: 'POST', dataType: 'json',
                    data: { form_key: window.FORM_KEY, type: root.getAttribute('data-type'), id: job.id, store: job.store, overwrite: overwrite ? 1 : 0 }
                });
                if (data.ok) {
                    job.cell.className = 'supertext-state ' + (data.status === 'unchanged' ? 'translated' : 'done');
                    job.cell.textContent = '✓ ' + data.message;
                    if (data.editUrl) {
                        var link = document.createElement('a'); link.href = data.editUrl; link.textContent = ' ' + t.open;
                        job.cell.appendChild(link);
                    }
                    (data.notes || []).forEach(function (note) {
                        var small = document.createElement('small'); small.textContent = note; job.cell.appendChild(small);
                    });
                    counts[data.status === 'unchanged' ? 'skipped' : 'ok']++;
                } else {
                    job.cell.className = 'supertext-state error'; job.cell.textContent = '✕ ' + (data.message || t.failed);
                    counts.failed++;
                }
            } catch (e) {
                var message = (e && e.responseJSON && e.responseJSON.message) || t.failed;
                job.cell.className = 'supertext-state error'; job.cell.textContent = '✕ ' + message;
                counts.failed++;
            }
        }
        var summary = root.querySelector('.supertext-summary');
        summary.firstElementChild.textContent = t.done.replace('%1', counts.ok).replace('%2', counts.skipped).replace('%3', counts.failed)
            + (counts.skipped && !overwrite ? ' ' + t.hint : '');
        summary.className = 'message supertext-summary ' + (counts.failed ? 'message-warning' : 'message-success');
        summary.style.display = 'block';
        go.disabled = false;
    });
});
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
