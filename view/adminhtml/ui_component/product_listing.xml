<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds "Translate with Supertext" to the list's mass actions. -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="supertext_translate">
                <settings>
                    <url path="supertext/translate/mass">
                        <param name="type">product</param>
                    </url>
                    <type>supertext_translate</type>
                    <label translate="true">Translate with Supertext</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
</listing>
