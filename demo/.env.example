# Variables of the demo container. On Railway they are service variables; never commit real values.

# MySQL server; the Magento database (MAGENTO_DB_NAME, default "magento") is created there if missing.
# The user needs to create databases (root on the shared Railway MySQL).
DATABASE_URL=mysql://root:password@localhost:3306/mysql
# MAGENTO_DB_NAME=magento
# Public host name; on Railway RAILWAY_PUBLIC_DOMAIN is used automatically.
# MAGENTO_DOMAIN=magento-production.up.railway.app

# Elasticsearch 8 (shared service on Railway).
# ELASTICSEARCH_HOST=elasticsearch.railway.internal
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_INDEX_PREFIX=supertext_magento_demo

# Supertext API key. No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
# For the stand-in API (tests/docs/stand-in.mjs) use any key and the local endpoint.
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=http://127.0.0.1:8765/v1/
# Optional: another review service for store views with "Translation review" set to Yes
# (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# Send version information to Supertext (shop URL and versions; no content, no key): on by default.
# 0 turns it off and wins over the module setting.
# SUPERTEXT_VERSION_REPORTS=0
# Tests only: where version reports go (e.g. the stand-in's fake center).
# SUPERTEXT_REPORT_URL=http://127.0.0.1:8765/report

# Accounts created on every start if missing (existing accounts are never changed).
# They log in with the email address as user name.
# Magento's password rules (Mage-OS 3): at least 12 characters with letters and digits.
# DEMO_ADMIN_EMAIL=you@example.com
# DEMO_ADMIN_PASSWORD=
# The editor gets the role "Supertext editor" (catalog, content, Translate with Supertext).
# DEMO_EDITOR_EMAIL=editor@example.com
# DEMO_EDITOR_PASSWORD=
